# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://hbinushi:1234@cluster0.1peec.mongodb.net/?appName=Cluster0
MONGODB_DB=skeleton_id

# ── Service Ports ─────────────────────────────────────────────────────────────
GATEWAY_PORT=8000
VIDEO_SERVICE_PORT=8001
POSE_SERVICE_PORT=8002
FEATURE_SERVICE_PORT=8003
IDENTIFICATION_SERVICE_PORT=8004

# ── Model Configuration ──────────────────────────────────────────────────────
MODEL_DIR=./models
CONFIDENCE_THRESHOLD=0.65
SVM_WEIGHT=0.5
LSTM_WEIGHT=0.5

# ── Video Configuration ──────────────────────────────────────────────────────
CAMERA_INDEX=0
# Phone camera URL — install "IP Webcam" app on your phone, start server, and paste URL below
# Example: http://192.168.1.5:8080/video
CAMERA_URL=
FRAME_WIDTH=640
FRAME_HEIGHT=480
TARGET_FPS=30
SKIP_FRAMES=1

# ── Pose Estimation ──────────────────────────────────────────────────────────
MEDIAPIPE_MODEL_COMPLEXITY=0
MIN_DETECTION_CONFIDENCE=0.5
MIN_TRACKING_CONFIDENCE=0.5

# ── LSTM Configuration ───────────────────────────────────────────────────────
LSTM_SEQUENCE_LENGTH=30
LSTM_HIDDEN_SIZE=128
LSTM_NUM_LAYERS=2
LSTM_EPOCHS=100
LSTM_BATCH_SIZE=32
LSTM_LEARNING_RATE=0.001

# ── Enrollment ────────────────────────────────────────────────────────────────
ENROLLMENT_DURATION_SECONDS=60
MIN_ENROLLMENT_FRAMES=100
