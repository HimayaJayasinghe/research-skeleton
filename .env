# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://hbinushi:1234@cluster0.1peec.mongodb.net/?appName=Cluster0
MONGODB_DB=skeleton_id

# ── Service Ports ─────────────────────────────────────────────────────────────
GATEWAY_PORT=8080
VIDEO_SERVICE_PORT=8001
POSE_SERVICE_PORT=8002
FEATURE_SERVICE_PORT=8003
IDENTIFICATION_SERVICE_PORT=8004

# ── Model Configuration ──────────────────────────────────────────────────────
MODEL_DIR=./models
CONFIDENCE_THRESHOLD=0.50
SVM_WEIGHT=0.5
LSTM_WEIGHT=0.5

# ── Video Configuration ──────────────────────────────────────────────────────
CAMERA_INDEX=0
# Phone camera URL — install "IP Webcam" app on your phone, start server, and paste URL below
# Example: http://192.168.1.5:8080/video
CAMERA_URL=
FRAME_WIDTH=640
FRAME_HEIGHT=480
TARGET_FPS=30
SKIP_FRAMES=1

# ── Pose Estimation ──────────────────────────────────────────────────────────
MEDIAPIPE_MODEL_COMPLEXITY=0
MIN_DETECTION_CONFIDENCE=0.3
MIN_TRACKING_CONFIDENCE=0.3

# ── LSTM Configuration ───────────────────────────────────────────────────────
LSTM_SEQUENCE_LENGTH=30
LSTM_HIDDEN_SIZE=128
LSTM_NUM_LAYERS=2
LSTM_EPOCHS=100
LSTM_BATCH_SIZE=32
LSTM_LEARNING_RATE=0.001

# ── Enrollment ────────────────────────────────────────────────────────────────
ENROLLMENT_DURATION_SECONDS=60
MIN_ENROLLMENT_FRAMES=200

# ── IP Camera (Hikvision HK2) ────────────────────────────────────────────────
IP_CAMERA_HOST=169.254.110.15
IP_CAMERA_USER=admin
IP_CAMERA_PASS=admin
# RTSP stream — adjust path if stream1 doesn't work (try /h264/ch1/main/av_stream)
IP_CAMERA_RTSP_URL=rtsp://admin:admin@169.254.110.15:554/stream1
# Snapshot HTTP URL (leave blank to auto-detect)
IP_CAMERA_SNAPSHOT_URL=
